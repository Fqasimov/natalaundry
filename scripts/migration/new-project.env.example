# Target Supabase project — copy this OUTSIDE the repository, fill it in,
# and point TARGET_ENV at your copy:
#
#   cp scripts/migration/new-project.env.example ~/nata-target.env
#   export TARGET_ENV=~/nata-target.env
#
# Do not fill this file in place. It is committed, and a filled-in copy would
# put a live database password in the repository history.
#
# ---------------------------------------------------------------------------
#
# NEW_PROJECT_REF
#   Dashboard -> Project Settings -> General -> "Reference ID".
#   Also the first part of https://<ref>.supabase.co
#
# NEW_DB_HOST
#   Dashboard -> Connect -> "Session pooler" tab -> Host.
#   Looks like: aws-1-eu-central-1.pooler.supabase.com
#
#   SESSION pooler, not Transaction. pg_dump and psql set session-level state
#   that transaction-mode pooling drops partway through, and a restore that
#   fails halfway with objects already created is a bad afternoon. The
#   application switches to the transaction pooler (6543) afterwards.
#
# NEW_DB_USER
#   From the same panel. Looks like: postgres.<ref>
#
# NEW_DB_PASSWORD
#   The database password set when the project was created, or a fresh one
#   from Project Settings -> Database -> Reset database password. Resetting is
#   free until something depends on it.
#
#   No quotes and no spaces around the "=". If it contains a "#" or a space,
#   wrap the whole value in double quotes.

NEW_PROJECT_REF=
NEW_DB_HOST=
NEW_DB_USER=
NEW_DB_PASSWORD=
NEW_DB_DATABASE=postgres

# Needed only when repointing the app at the end. Both are safe to share —
# the anon key ships inside the app bundle by design.
#   Dashboard -> Project Settings -> API
NEW_SUPABASE_URL=
NEW_ANON_KEY=
