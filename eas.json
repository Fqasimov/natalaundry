{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_CARD_PAYMENTS": "true"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "../../.play-store/service-account.json",
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6793012757",
        "appleTeamId": "LJ6BQ556G4",
        "ascApiKeyPath": "../../.app-store/AuthKey_658G7R82ZW.p8",
        "ascApiKeyId": "658G7R82ZW",
        "ascApiKeyIssuerId": "aa65687e-29cd-45ed-8e53-13ab4489eb12"
      }
    }
  }
}
