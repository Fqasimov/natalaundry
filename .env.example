# Copy this file to .env and fill in real values.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time — only put
# values here that are safe for a client app to hold (anon/publishable keys),
# never a service_role key or Supabase personal access token.
#
# THIS FILE ONLY COVERS LOCAL DEVELOPMENT. .env is gitignored, so it is never
# uploaded to EAS Build — a cloud build sees none of it. The same four values
# are stored as EAS environment variables (production, preview, development,
# visibility "sensitive") and that is what a build reads:
#
#   node node_modules/eas-cli/bin/run env:list --environment production
#
# Change one here and you have changed it for your machine only. Change it in
# both, or a build will keep using the old value. Getting this wrong is quiet:
# Metro does not execute modules, so a missing key still bundles cleanly and
# only throws at launch, on the device, as a blank screen (lib/supabase.ts).

EXPO_PUBLIC_SUPABASE_URL=https://kzfsagccvxjmsbqjdpnb.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# There is deliberately no EXPO_PUBLIC_API_URL here. The app used to post
# orders to a Laravel API; it now writes straight to Supabase, where triggers
# reprice the basket and SECURITY DEFINER functions guard the races. Laravel
# still exists, but only to serve the admin console, which the app never calls.
#
# Google Cloud project: project-067f4a2d-3b2f-4589-8f7 (org faiq-farid0604-org).
# Restrict this key in the Cloud Console to the Maps JavaScript API and the
# Geocoding API only. It ships inside the JS bundle, so the API restriction —
# plus an HTTP-referrer / bundle-id restriction — is what protects it, not
# secrecy. Deliberately NOT enabled for any Fleet Engine / live-tracking API:
# courier positions go through our own courier_locations table instead.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# OpenRouteService — driving distance and time on the courier's job card.
#
# Free key, no card required, 2,000 requests/day: openrouteservice.org/dev
# Chosen over Google Directions and Mapbox for exactly that reason. Results are
# cached for a day per coordinate pair, so real usage is a tiny fraction of the
# allowance.
#
# Like every EXPO_PUBLIC_* value this ships inside the bundle and is
# extractable. That is accepted: it spends a free quota, holds no money and no
# data, and is revocable from the ORS dashboard. Leave it blank and the app
# simply shows no distance — nothing breaks.
EXPO_PUBLIC_ORS_API_KEY=

# The EAS project that over-the-air updates publish to.
#
# OPTIONAL, and normally left blank. The real id is hardcoded in app.config.ts,
# because this file is gitignored and therefore never reaches EAS Build — a
# cloud build reading the id from here would find nothing and quietly ship a
# binary with no update capability at all.
#
# Set it only to point a fork or a second Expo project at a different EAS
# project; it overrides the hardcoded default when present.
EAS_PROJECT_ID=
