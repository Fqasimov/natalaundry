APP_NAME="Nata Laundry API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — the SAME Postgres the mobile app already uses via Supabase.
# Host/password come from Supabase Dashboard -> Project Settings -> Database.
# Prefer the connection pooler host for serverless/PHP-FPM deployments.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.dzplzvogobqmwaaimkef
DB_PASSWORD=
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# Supabase auth. JWT secret: Project Settings -> API -> JWT Settings.
# It is what signs the access tokens the app sends; never expose it publicly.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://dzplzvogobqmwaaimkef.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Business rules (see config/nata.php). Defaults match the shipped 1.0.2 app.
# ---------------------------------------------------------------------------
NATA_FREE_DELIVERY_THRESHOLD=40
NATA_BASE_DELIVERY_FEE=5
NATA_OUTSIDE_CITY_FEE=5

# This API is stateless: callers authenticate with a Supabase JWT on every
# request, there is no server-side login and no web session to keep. Database
# drivers here would mean three tables Laravel's base migrations create
# (sessions, cache, jobs) — and those migrations also create `users`, which
# must never run against the Supabase database. File and cookie drivers keep
# the deployment to a single schema we own.
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=cookie

# Server-side Google key, used for Geocoding only (turning a typed address
# into coordinates when an order is placed). Separate from the app's key so it
# can be locked to the server's IP rather than a bundle id, and so rotating one
# doesn't force an app release.
GOOGLE_MAPS_API_KEY=

# First-order welcome offer. Applied automatically — customers never type it.
NATA_FIRST_ORDER_PROMO=true
NATA_FIRST_ORDER_CODE=ILK20
NATA_FIRST_ORDER_PERCENT=20

# Live courier tracking (our own polling endpoints, not a paid fleet product).
NATA_TRACKING_PING_SECONDS=5
NATA_TRACKING_STALE_SECONDS=60
NATA_TRACKING_RETAIN_HOURS=24

# Publishable key, handed to the admin console in the browser so staff can sign
# in with their normal Supabase credentials. RLS protects the data, not this
# key's secrecy. Never put the service_role key here.
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Kapital Bank e-commerce gateway
# ---------------------------------------------------------------------------
# These are ACQUIRER credentials — they can move money. Unlike SUPABASE_ANON_KEY
# they are secret, belong only in the server's environment, and must never be
# copied into the app's .env or any EXPO_PUBLIC_* variable, since everything
# prefixed EXPO_PUBLIC_ is inlined into the JS bundle and shipped to phones.
#
# Test:       https://txpgtst.kapitalbank.az/api
# Production: https://e-commerce.kapitalbank.az/api
KAPITAL_BASE_URL=https://txpgtst.kapitalbank.az/api

# The published sandbox pair. Replace with the real merchant credentials in
# production — and do not leave these in place on a production host.
KAPITAL_USERNAME=TerminalSys/kapital
KAPITAL_PASSWORD=kapital123

KAPITAL_CURRENCY=AZN
KAPITAL_TIMEOUT=20

# Where the bank returns the customer's browser. Must be a public https URL on
# this API — the bank redirects a browser, so a natalaundry:// deep link would
# strand them. The handler verifies with the bank, then bounces into the app.
KAPITAL_CALLBACK_URL=https://api.natalaundry.az/api/payments/callback
KAPITAL_APP_RETURN_SCHEME=natalaundry

# Apple Pay / Google Pay. OFF until Kapital confirms wallet acceptance is
# enabled on the merchant terminal. See config/kapital.php for why: the
# documented API accepts "paymentMethods": ["Card"] only, so the wallet
# buttons route through the same hosted page rather than a native sheet.
KAPITAL_WALLETS_ENABLED=false
