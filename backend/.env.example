APP_NAME="Nata Laundry API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — the SAME Postgres the mobile app already uses via Supabase.
# Host/password come from Supabase Dashboard -> Project Settings -> Database.
# Prefer the connection pooler host for serverless/PHP-FPM deployments.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.dzplzvogobqmwaaimkef
DB_PASSWORD=
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# Supabase auth. JWT secret: Project Settings -> API -> JWT Settings.
# It is what signs the access tokens the app sends; never expose it publicly.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://dzplzvogobqmwaaimkef.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Business rules (see config/nata.php). Defaults match the shipped 1.0.2 app.
# ---------------------------------------------------------------------------
NATA_FREE_DELIVERY_THRESHOLD=40
NATA_BASE_DELIVERY_FEE=5
NATA_OUTSIDE_CITY_FEE=5

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# Server-side Google key, used for Geocoding only (turning a typed address
# into coordinates when an order is placed). Separate from the app's key so it
# can be locked to the server's IP rather than a bundle id, and so rotating one
# doesn't force an app release.
GOOGLE_MAPS_API_KEY=

# First-order welcome offer. Applied automatically — customers never type it.
NATA_FIRST_ORDER_PROMO=true
NATA_FIRST_ORDER_CODE=ILK20
NATA_FIRST_ORDER_PERCENT=20

# Live courier tracking (our own polling endpoints, not a paid fleet product).
NATA_TRACKING_PING_SECONDS=5
NATA_TRACKING_STALE_SECONDS=60
NATA_TRACKING_RETAIN_HOURS=24
